# Copy to .env.local and fill in. Never commit real values.

# Public (sent to the browser) — Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — where auth emails send people back to
# (http://localhost:3000 locally, the Vercel URL in production)
SITE_URL=http://localhost:3000

# Server-only — OpenRouter key for all AI calls (extraction + embeddings). Never NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# LOCAL SCRIPTS ONLY (seed, backfill, eval) — bypasses RLS. Never in app code, never in Vercel, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — the public demo login for the "Try the demo account" button (never NEXT_PUBLIC_).
# Also used by scripts/reset-demo-account.mjs to reset the demo password.
DEMO_EMAIL=
DEMO_PASSWORD=

# Server-only kill switch for invites + chat (phase 7b-1). "true" = on; anything else = hidden.
# Set it to true for Preview in Vercel; leave Production unset until tested. Never NEXT_PUBLIC_.
MESSAGING_ENABLED=

# Server-only speech input (phase 8): ElevenLabs key + kill switch + retirement date.
# On only if SPEECH_ENABLED=true AND today (Berlin) <= SPEECH_UNTIL (YYYY-MM-DD). Never NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
SPEECH_ENABLED=
SPEECH_UNTIL=

# Only for scripts/rls-check.mjs (two confirmed test accounts)
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
