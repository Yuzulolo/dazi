# Copy to .env.local and fill in. Never commit real values.

# Public (sent to the browser) — Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — where auth emails send people back to
# (http://localhost:3000 locally, the Vercel URL in production)
SITE_URL=http://localhost:3000

# Server-only — OpenRouter key for all AI calls (extraction + embeddings). Never NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# LOCAL SCRIPTS ONLY (seed, backfill, eval) — bypasses RLS. Never in app code, never in Vercel, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — the public demo login for the "Try the demo account" button (never NEXT_PUBLIC_).
# Also used by scripts/reset-demo-account.mjs to reset the demo password.
DEMO_EMAIL=
DEMO_PASSWORD=

# Only for scripts/rls-check.mjs (two confirmed test accounts)
TEST_A_EMAIL=
TEST_A_PASSWORD=
TEST_B_EMAIL=
TEST_B_PASSWORD=
